{
  "name": "integration-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "build:web": "pnpm --dir web build",
    "build:worker": ". scripts/env.sh && cd worker && worker-build --release",
    "build": "pnpm build:web && pnpm build:worker",
    "dev": "pnpm build:web && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply integration-hub --local",
    "test:worker": ". scripts/env.sh && cd worker && cargo test",
    "test:web": "pnpm --dir web test",
    "test:e2e": "pnpm --dir e2e test"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
